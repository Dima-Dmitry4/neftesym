// Debug-тест: открываем страницу и проверяем что графики реально рендерятся.
import { test, expect } from '@playwright/test';

test('debug: charts are visible', async ({ page }) => {
  const errors: string[] = [];
  page.on('pageerror', (err) => errors.push(`pageerror: ${err.message}`));
  page.on('console', (msg) => {
    if (msg.type() === 'error') errors.push(`console.error: ${msg.text()}`);
  });

  await page.goto('/');
  await page.waitForTimeout(3000); // дать UI отрисоваться

  // 1) проверить наличие #view-charts
  const viewCharts = await page.locator('#view-charts').count();
  console.log('view-charts count:', viewCharts);

  // 2) проверить наличие 6 canvas
  const canvases = await page.locator('.chart-canvas').count();
  console.log('chart-canvas count:', canvases);

  // 3) размеры каждого canvas
  for (let i = 0; i < canvases; i++) {
    const c = page.locator('.chart-canvas').nth(i);
    const box = await c.boundingBox();
    const chartBlock = c.locator('xpath=..');
    const blockBox = await chartBlock.boundingBox();
    const chartName = await c.getAttribute('data-chart');
    console.log(
      `chart ${i} (${chartName}): canvas=${box?.width}x${box?.height}, block=${blockBox?.width}x${blockBox?.height}`,
    );
  }

  // 4) размеры родителя
  const chartsRoot = await page.locator('[data-charts-root]').boundingBox();
  console.log('charts-root box:', chartsRoot);

  // 5) наличие ошибок в консоли
  console.log('errors:', errors);

  // Скриншот для диагностики
  await page.screenshot({ path: 'tests/e2e/debug.png', fullPage: false });
});
