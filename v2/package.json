{
  "name": "oilgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Браузерный симулятор добычи нефти (учебный уровень реализма)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "sim": "node --import tsx ./src/cli/simCli.ts",
    "standalone": "npm run build && node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
